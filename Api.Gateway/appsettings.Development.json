{
  "ReverseProxy": {
    "Keycloak": {
      "Authority": "http://localhost:8080/realms/minicommerce",
      "Audience": "minicommerce-api",
      "RequireHttpsMetadata": false
    },
    "HttpClient": {

      "DangerousAcceptAnyServerCertificate": true

    },
    "Routes": {

      "orders-route": {

        "ClusterId": "orders-cluster",

        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }

      },


      "inventory-route": {

        "ClusterId": "inventory-cluster",

        "Match": {
          "Path": "/api/inventory/{**catch-all}"
        }

      },


      "payment-route": {

        "ClusterId": "payment-cluster",

        "Match": {
          "Path": "/api/payment/{**catch-all}"
        }

      },


      "shipping-route": {

        "ClusterId": "shipping-cluster",

        "Match": {
          "Path": "/api/shipping/{**catch-all}"
        }

      }

    },


    "Clusters": {


      "orders-cluster": {

        "Destinations": {

          "orders-api": {

            "Address": "https://localhost:7001/"

          }

        }

      },


      "inventory-cluster": {

        "Destinations": {

          "inventory-api": {

            "Address": "https://localhost:7002/"

          }

        }

      },


      "payment-cluster": {

        "Destinations": {

          "payment-api": {

            "Address": "https://localhost:7003/"

          }

        }

      },


      "shipping-cluster": {

        "Destinations": {

          "shipping-api": {

            "Address": "https://localhost:7004/"

          }

        }

      }

    }

  }
}